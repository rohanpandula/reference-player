index 0000000..165ef3b
--- /dev/null
+++ b/Tests/AetherEngineTests/DoviReconstructionPrecisionTests.swift
@@ -0,0 +1,95 @@
+#if DualLayerDolbyVision
+import Testing
+import Dovi
+@testable import AetherEngine
+
+@Suite(.offCooperativePoolOneLane)
+struct DoviReconstructionPrecisionTests {
+    @Test("prediction and signed residual retain fractional VDR codes until the final rounding",
+          arguments: [(514, 2050), (510, 2047), (513, 2049), (511, 2048), (512, 2048)])
+    func roundsAfterAddition(el: Int, expected: Int) throws {
+        let composer = try #require(DoviFelComposer())
+        var p = DoviGpuEdgeCaseTests.params()
+        p.ditherMode = .debugRawVDR
+        var curve = DoviGpuCurveSweepTests.identityCurve()
+        curve.coef[0] = [4195123, 0, 0]
+        p.polyY = curve; p.polyCb = curve; p.polyCr = curve
+        // ETSI 5.4: prediction16 = 4195123 >> 7 = 32774. For EL514,
+        // residual16 = 3*2048 >> 8 = 24; (32774+24+8)>>4 = 2050.
+        let out = try DoviGpuEdgeCaseTests.composeConstant(composer, bl: (512, 512, 512),
+                                                         el: (el, el, el), params: p)
+        for plane in DoviTestSupport.rawVDR(out) {
+            #expect(Set(plane) == [expected])
+        }
+    }
+    @Test("wide MMR coefficients cancel exactly on the GPU")
+    func wideCancellation() throws {
+        let composer = try #require(DoviFelComposer())
+        var p = DoviGpuEdgeCaseTests.params(flags: [.disableResidual, .lumaMmr])
+        p.ditherMode = .debugRawVDR
+        var curve = p.polyY
+        curve.method[0] = DoviMapping.mmr.rawValue
+        curve.order[0] = 1
+        var mmr = DoviMmrParams()
+        mmr.coefShift = 23
+        mmr.constant[0] = (32768 << 23) + (1 << 22) + 3072
+        mmr.coef[0][0] = -(65536 << 23)
+        p.polyY = curve; p.polyCb = curve; p.polyCr = curve
+        p.mmrY = mmr; p.mmrCb = mmr; p.mmrCr = mmr
+        // 32768.5003662109375 - 65536*0.5 = 0.5003662109375;
+        // prediction16=32792, rounded12=2050. Float32 drops the small remainder.
+        let out = try DoviGpuEdgeCaseTests.composeConstant(composer, bl: (512, 512, 512),
+                                                         el: (512, 512, 512), params: p)
+        for plane in DoviTestSupport.rawVDR(out) { #expect(Set(plane) == [2050]) }
+    }
+
+    @Test("full-range order-three MMR sums clamp without signed accumulator overflow", arguments: [true, false])
+    func wideAccumulator(positive: Bool) throws {
+        let composer = try #require(DoviFelComposer())
+        var p = DoviGpuEdgeCaseTests.params(flags: [.disableResidual, .lumaMmr])
+        p.ditherMode = .debugRawVDR
+        var curve = p.polyY
+        curve.method[0] = DoviMapping.mmr.rawValue
+        curve.order[0] = 3
+        var mmr = DoviMmrParams()
+        mmr.coefShift = 23
+        let coefficient: Int64 = positive ? (65536 << 23) - 1 : -(65536 << 23)
+        mmr.constant[0] = coefficient
+        mmr.coef[0] = Array(repeating: coefficient, count: 21)
+        p.polyY = curve; p.polyCb = curve; p.polyCr = curve
+        p.mmrY = mmr; p.mmrCb = mmr; p.mmrCr = mmr
+        let out = try DoviGpuEdgeCaseTests.composeConstant(composer, bl: (1023, 1023, 1023),
+                                                         el: (512, 512, 512), params: p)
+        for plane in DoviTestSupport.rawVDR(out) { #expect(Set(plane) == [positive ? 4095 : 0]) }
+    }
+
+    @Test("a fractional VDR-code ceiling survives parsing and affects the final GPU rounding", arguments: [UInt64(0), 1536])
+    func fractionalResidualCeiling(maximum: UInt64) throws {
+        var data = DoviRpuDataNlq()
+        data.nlq_offset = (512, 512, 512)
+        data.linear_deadzone_slope = (2048, 2048, 2048)
+        data.vdr_in_max = (maximum, maximum, maximum)
+        let nlq = withUnsafePointer(to: &data) {
+            DoviFelComposer.parseNlqParams(nlq: $0, component: 0, label: "Y", method: .linear,
+                                          coefLog2Denom: 23, nlqShift: 11, pivots: [0, 1023])
+        }
+        #expect(nlq.vdrInMax == 0)
+        if maximum == 0 {
+            #expect(nlq.nlqScale == 0)
+        } else {
+            #expect(nlq.nlqScale == 2048)
+            #expect(nlq.vdrInMaxFp == 1536)
+            #expect(DoviFelComposer.inverseNlq16(nlq, elCode: 1023, vdrBitDepth: 12) == 12)
+        }
+        let composer = try #require(DoviFelComposer())
+        var p = DoviGpuEdgeCaseTests.params()
+        p.ditherMode = .debugRawVDR
+        p.nlqY = nlq; p.nlqCb = nlq; p.nlqCr = nlq
+        let out = try DoviGpuEdgeCaseTests.composeConstant(composer, bl: (512, 512, 512),
+                                                         el: (1023, 1023, 1023), params: p)
+        // The 0.75-code ceiling becomes 12 in the 16-bit domain: (32768+12+8)>>4 = 2049.
+        for plane in DoviTestSupport.rawVDR(out) { #expect(Set(plane) == [maximum == 0 ? 2048 : 2049]) }
+    }
+
+}
+#endif
