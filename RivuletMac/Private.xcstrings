{
  "sourceLanguage" : "en",
  "strings" : {
    "Reference Player" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reference Player"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reference Player"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reference Player"
          }
        }
      }
    },
    "Reference Player is based on Rivulet, Copyright © 2025–2026 Bain Gurley.\n\nReference Player is distributed under the PolyForm Noncommercial License 1.0.0, which permits use for noncommercial purposes. The complete license text is included with the source distribution.\n\nReference Player is a client for media you provide. It does not host, supply, or distribute any video, audio, or channel content of its own.\n\nThis product uses the TMDB API but is not endorsed or certified by TMDB. Metadata and artwork in Discover and recommendations are provided by The Movie Database (themoviedb.org)." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reference Player is based on Rivulet, Copyright © 2025–2026 Bain Gurley.\n\nReference Player is distributed under the PolyForm Noncommercial License 1.0.0, which permits use for noncommercial purposes. The complete license text is included with the source distribution.\n\nReference Player is a client for media you provide. It does not host, supply, or distribute any video, audio, or channel content of its own.\n\nThis product uses the TMDB API but is not endorsed or certified by TMDB. Metadata and artwork in Discover and recommendations are provided by The Movie Database (themoviedb.org)."
          }
        }
      }
    },
    "Reference Player needs %@ Server %lld.%lld.%lld or newer." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reference Player benötigt %1$@-Server %2$lld.%3$lld.%4$lld oder neuer."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Reference Player needs %1$@ Server %2$lld.%3$lld.%4$lld or newer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reference Player nécessite %1$@ Server %2$lld.%3$lld.%4$lld ou ultérieur."
          }
        }
      }
    },
    "That server refused Reference Player." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Server hat Reference Player abgewiesen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο διακομιστής απέρριψε το Reference Player."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce serveur a refusé Reference Player."
          }
        }
      }
    },
    "The server address from your provider, with its port. You can also paste a get.php link: Reference Player fills in the username and password from it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Serveradresse deines Anbieters mit Port. Du kannst auch einen get.php-Link einfügen: Reference Player übernimmt daraus Benutzername und Passwort."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η διεύθυνση και η θύρα του διακομιστή του παρόχου. Μπορείς να επικολλήσεις και σύνδεσμο get.php: το Reference Player συμπληρώνει τα στοιχεία σύνδεσης από αυτόν."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’adresse du serveur de votre fournisseur, avec son port. Vous pouvez aussi coller un lien get.php : Reference Player en extrait le nom d’utilisateur et le mot de passe."
          }
        }
      }
    },
    "This server runs Jellyfin %@. Reference Player needs %lld.%lld or newer." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf diesem Server läuft Jellyfin %@. Reference Player benötigt %lld.%lld oder neuer."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This server runs Jellyfin %1$@. Reference Player needs %2$lld.%3$lld or newer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce serveur exécute Jellyfin %1$@. Reference Player nécessite %2$lld.%3$lld ou ultérieur."
          }
        }
      }
    },
    "Tvheadend didn't give Reference Player a stream for this user. Check its streaming rights, or update Tvheadend." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tvheadend hat Reference Player für diesen Benutzer keinen Stream geliefert. Prüfe seine Streaming-Rechte oder aktualisiere Tvheadend."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Tvheadend δεν έδωσε ροή στο Reference Player για αυτόν τον χρήστη. Έλεγξε τα δικαιώματα μετάδοσης ή ενημέρωσε το Tvheadend."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tvheadend n’a pas fourni de flux à Reference Player pour cet utilisateur. Vérifiez ses droits de streaming, ou mettez Tvheadend à jour."
          }
        }
      }
    },
    "Upstream Release History" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upstream Release History"
          }
        },
        "de" : {
