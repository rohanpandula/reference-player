            "state" : "translated",
            "value" : "Upstream-Versionsverlauf"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ιστορικό εκδόσεων του αρχικού έργου"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Historique des versions du projet d’origine"
          }
        }
      }
    },
    "Used by libass for bidirectional text. FriBidi 1.0.16, statically linked and used under the GNU Lesser General Public License, version 2.1, whose full text is reproduced in the FFmpeg entry above. It is built unmodified from https://github.com/fribidi/fribidi (tag v1.0.16); https://github.com/l984-451/LibassBuild holds the build script, and Reference Player's source is at https://github.com/rohanpandula/reference-player, so the app can be rebuilt against a modified FriBidi." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Used by libass for bidirectional text. FriBidi 1.0.16, statically linked and used under the GNU Lesser General Public License, version 2.1, whose full text is reproduced in the FFmpeg entry above. It is built unmodified from https://github.com/fribidi/fribidi (tag v1.0.16); https://github.com/l984-451/LibassBuild holds the build script, and Reference Player's source is at https://github.com/rohanpandula/reference-player, so the app can be rebuilt against a modified FriBidi."
          }
        }
      }
    }
  },
  "version" : "1.0"
}
