{
  "sourceLanguage" : "en",
  "strings" : {
    "Reference Video Player" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reference Video Player"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reference Video Player"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reference Video Player"
          }
        }
      }
    },
    "Reference Video Player is based on Rivulet, Copyright © 2025–2026 Bain Gurley.\n\nReference Video Player is distributed under the PolyForm Noncommercial License 1.0.0, which permits use for noncommercial purposes. The complete license text is included with the source distribution.\n\nReference Video Player is a client for media you provide. It does not host, supply, or distribute any video, audio, or channel content of its own.\n\nThis product uses the TMDB API but is not endorsed or certified by TMDB. Metadata and artwork in Discover and recommendations are provided by The Movie Database (themoviedb.org)." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reference Video Player is based on Rivulet, Copyright © 2025–2026 Bain Gurley.\n\nReference Video Player is distributed under the PolyForm Noncommercial License 1.0.0, which permits use for noncommercial purposes. The complete license text is included with the source distribution.\n\nReference Video Player is a client for media you provide. It does not host, supply, or distribute any video, audio, or channel content of its own.\n\nThis product uses the TMDB API but is not endorsed or certified by TMDB. Metadata and artwork in Discover and recommendations are provided by The Movie Database (themoviedb.org)."
          }
        }
      }
    },
    "Reference Video Player needs %@ Server %lld.%lld.%lld or newer." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reference Video Player benötigt %1$@-Server %2$lld.%3$lld.%4$lld oder neuer."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Reference Video Player needs %1$@ Server %2$lld.%3$lld.%4$lld or newer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reference Video Player nécessite %1$@ Server %2$lld.%3$lld.%4$lld ou ultérieur."
          }
        }
      }
    },
    "That server refused Reference Video Player." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Server hat Reference Video Player abgewiesen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο διακομιστής απέρριψε το Reference Video Player."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce serveur a refusé Reference Video Player."
          }
        }
      }
    },
    "The server address from your provider, with its port. You can also paste a get.php link: Reference Video Player fills in the username and password from it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Serveradresse deines Anbieters mit Port. Du kannst auch einen get.php-Link einfügen: Reference Video Player übernimmt daraus Benutzername und Passwort."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η διεύθυνση και η θύρα του διακομιστή του παρόχου. Μπορείς να επικολλήσεις και σύνδεσμο get.php: το Reference Video Player συμπληρώνει τα στοιχεία σύνδεσης από αυτόν."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’adresse du serveur de votre fournisseur, avec son port. Vous pouvez aussi coller un lien get.php : Reference Video Player en extrait le nom d’utilisateur et le mot de passe."
          }
        }
      }
    },
    "This server runs Jellyfin %@. Reference Video Player needs %lld.%lld or newer." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf diesem Server läuft Jellyfin %@. Reference Video Player benötigt %lld.%lld oder neuer."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This server runs Jellyfin %1$@. Reference Video Player needs %2$lld.%3$lld or newer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce serveur exécute Jellyfin %1$@. Reference Video Player nécessite %2$lld.%3$lld ou ultérieur."
          }
        }
      }
    },
    "Tvheadend didn't give Reference Video Player a stream for this user. Check its streaming rights, or update Tvheadend." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tvheadend hat Reference Video Player für diesen Benutzer keinen Stream geliefert. Prüfe seine Streaming-Rechte oder aktualisiere Tvheadend."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Tvheadend δεν έδωσε ροή στο Reference Video Player για αυτόν τον χρήστη. Έλεγξε τα δικαιώματα μετάδοσης ή ενημέρωσε το Tvheadend."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tvheadend n’a pas fourni de flux à Reference Video Player pour cet utilisateur. Vérifiez ses droits de streaming, ou mettez Tvheadend à jour."
          }
        }
      }
    },
    "Upstream Release History" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upstream Release History"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upstream-Versionsverlauf"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ιστορικό εκδόσεων του αρχικού έργου"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Historique des versions du projet d’origine"
          }
        }
      }
    },
    "Used by libass for bidirectional text. FriBidi 1.0.16, statically linked and used under the GNU Lesser General Public License, version 2.1, whose full text is reproduced in the FFmpeg entry above. It is built unmodified from https://github.com/fribidi/fribidi (tag v1.0.16); https://github.com/l984-451/LibassBuild holds the build script, and Reference Video Player's source is at https://github.com/rohanpandula/reference-player, so the app can be rebuilt against a modified FriBidi." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Used by libass for bidirectional text. FriBidi 1.0.16, statically linked and used under the GNU Lesser General Public License, version 2.1, whose full text is reproduced in the FFmpeg entry above. It is built unmodified from https://github.com/fribidi/fribidi (tag v1.0.16); https://github.com/l984-451/LibassBuild holds the build script, and Reference Video Player's source is at https://github.com/rohanpandula/reference-player, so the app can be rebuilt against a modified FriBidi."
          }
        }
      }
    }
  },
  "version" : "1.0"
}
