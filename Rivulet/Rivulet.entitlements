<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.example.referenceplayer</string>
	</array>
	<!-- Reference Player: no upstream App Attest identity, and no aps-environment (it
	     rode the removed APPATTEST_ENVIRONMENT setting; only App Store Connect requires
	     it beside CloudKit). The owned App Group and iCloud container need a
	     provisioning team that supports them. -->
	<!-- iCloud sync of preferences (NSUbiquitousKeyValueStore). Same store as iOS: one bundle id. -->
	<key>com.apple.developer.ubiquity-kvstore-identifier</key>
	<string>$(TeamIdentifierPrefix)$(CFBundleIdentifier)</string>
	<!-- iCloud sync of sign-ins and Live TV sources: one encrypted CloudKit record. -->
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.com.example.referenceplayer.sync</string>
	</array>
</dict>
</plist>
