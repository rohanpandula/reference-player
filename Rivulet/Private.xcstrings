    "Where Home Assistant answers on your network, with its port." : {},
    "Where Home Assistant answers on your network, with its port. With no address, nothing is sent." : {},
    "Where the Apple TV fetches format-index.json, built from your library." : {},
    "Your Dispatcharr server. Reference Player loads its channels and guide, and records through it if you sign in." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Dispatcharr-Server. Reference Player lädt seine Sender und sein Programm und nimmt darüber auf, wenn du dich anmeldest."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο διακομιστής Dispatcharr. Το Reference Player φορτώνει κανάλια και οδηγό και, αν συνδεθείς, πραγματοποιεί εγγραφές."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre serveur Dispatcharr. Reference Player charge ses chaînes et son guide, et enregistre via lui si vous vous connectez."
          }
        }
      }
    },
    "Your MDBList API key." : {},
    "Your MDBList key, from mdblist.com under Preferences. It adds Metacritic and Letterboxd scores to a title's details. The free plan allows 1,000 lookups a day." : {},
    "Your TMDB API Key or API Read Access Token." : {},
    "Your TMDB API Key or Read Access Token (themoviedb.org, Settings, API). It turns on Discover, recommendations and actor biographies. Reopen the app after." : {},
    "Your Threadfin server. Reference Player loads its playlist and guide from the address." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Threadfin-Server. Reference Player lädt Playlist und Programm von dieser Adresse."
