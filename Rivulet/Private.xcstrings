          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο διακομιστής Tvheadend. Το Reference Video Player φορτώνει τα κανάλια και τον οδηγό και, αν συνδεθείς, πραγματοποιεί εγγραφές."
          }
        },
        "fr" : {
          "stringUnit" : {
